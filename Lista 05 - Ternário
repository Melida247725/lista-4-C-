a) Verifique se um número é par ou ímpar

using System;

class Program
{
    static void Main()
    {
        // Pede um número ao usuário
        Console.Write("Digite um número: ");
        int numero = int.Parse(Console.ReadLine());

        // Verifica se o resto da divisão por 2 é zero
        if (numero % 2 == 0)
        {
            // Se for zero, o número é par
            Console.WriteLine("O número é par.");
        }
        else
        {
            // Caso contrário, o número é ímpar
            Console.WriteLine("O número é ímpar.");
        }
    }
}


b) Encontre o maior entre dois números

using System;

class Program
{
    static void Main()
    {
        // Pede o primeiro número
        Console.Write("Digite o primeiro número: ");
        int numero1 = int.Parse(Console.ReadLine());

        // Pede o segundo número
        Console.Write("Digite o segundo número: ");
        int numero2 = int.Parse(Console.ReadLine());

        // Compara os dois números
        if (numero1 > numero2)
        {
            Console.WriteLine("O maior número é: " + numero1);
        }
        else if (numero2 > numero1)
        {
            Console.WriteLine("O maior número é: " + numero2);
        }
        else
        {
            // Caso os dois sejam iguais
            Console.WriteLine("Os dois números são iguais.");
        }
    }
}


