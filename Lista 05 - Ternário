i) Verifique se um número é divisível por outro

using System;

class Program
{
    static void Main()
    {
        // Pede o primeiro número
        Console.Write("Digite o primeiro número: ");
        int numero1 = int.Parse(Console.ReadLine());

        // Pede o segundo número
        Console.Write("Digite o segundo número: ");
        int numero2 = int.Parse(Console.ReadLine());

        // Verifica se o segundo número é zero
        if (numero2 == 0)
        {
            Console.WriteLine("Não é possível dividir por zero.");
        }
        // Verifica se o resto da divisão é zero
        else if (numero1 % numero2 == 0)
        {
            Console.WriteLine("O número é divisível pelo outro.");
        }
        else
        {
            Console.WriteLine("O número não é divisível pelo outro.");
        }
    }
}



