f) Calcule o valor absoluto de um número

using System;

class Program
{
    static void Main()
    {
        // Pede um número ao usuário
        Console.Write("Digite um número: ");
        double numero = double.Parse(Console.ReadLine());

        // Math.Abs() transforma o número em seu valor absoluto
        double valorAbsoluto = Math.Abs(numero);

        // Mostra o resultado
        Console.WriteLine("O valor absoluto é: " + valorAbsoluto);
    }
}



g) Verifique se um número é positivo, negativo ou zero

using System;

class Program
{
    static void Main()
    {
        // Pede um número ao usuário
        Console.Write("Digite um número: ");
        int numero = int.Parse(Console.ReadLine());

        // Verifica se o número é positivo
        if (numero > 0)
        {
            Console.WriteLine("O número é positivo.");
        }
        // Verifica se o número é negativo
        else if (numero < 0)
        {
            Console.WriteLine("O número é negativo.");
        }
        // Se não for positivo nem negativo, é zero
        else
        {
            Console.WriteLine("O número é zero.");
        }
    }
}



