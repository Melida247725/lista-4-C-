a)Escreva um programa que pergunte ao usuário sua idade e se tem carteira de
motorista. Se o usuário tiver mais de 18 anos e possuir carteira de motorista,
o programa deve imprimir "Você pode dirigir".

using System;
using System.Threading.Channels;
public class program
{
    static void Main(string[] args)
    {

        Console.Write("Digite sua idade: ");//pergunto a idade do usuario
        int i = int.Parse(Console.ReadLine());//usuario passa sua idade
        Console.WriteLine("voce tem carteira?");//pergunto se o usuario tem carteira
        string c = Console.ReadLine();//usuario passa se tem ou não carteir
        if (i >= 18 && c == "sim")//verifico se o usuario tem idade maior ou igual a 18 e se ele tem carteira
        { Console.Write("você pode dirigir"); }//se sim, ele pode dirigir
        else//se não, ele não pode dirigir
        {
            Console.Write("você não pode dirigir");//se não, ele não pode dirigi
        }
    }
}


